# Copy this file to .env and replace placeholders locally. Never commit .env.
# Local development defaults are listed here. Docker Compose overrides internal hostnames.
NODE_ENV=development
# Optional explicit browser origin. Leave blank for the local default (or let Compose derive it from WEB_PORT).
APP_ORIGIN=
WEB_PORT=3000
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001

# PostgreSQL. DATABASE_URL is optional; when blank, the API uses the individual POSTGRES_* values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veridian_service_desk
POSTGRES_USER=veridian_local
POSTGRES_PASSWORD=
DATABASE_URL=

# Server-only Gemini configuration. Do not use a NEXT_PUBLIC_ variable for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AGENT_MODE=auto

# Session cookies are secure only when the app is served over HTTPS.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# Docker/local demo account seed. Set a unique local password before
# `docker compose up --build`; it is never committed or baked into an image.
DEMO_REVIEWER_NAME=Demo Reviewer
DEMO_REVIEWER_EMAIL=reviewer@veridian.local
DEMO_REVIEWER_PASSWORD=
